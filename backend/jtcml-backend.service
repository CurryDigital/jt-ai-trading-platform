[Unit]
Description=JTCML Trading Platform Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.hermes/profiles/qr_frontend/workspace/jt-ai-trading-platform/backend
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ubuntu/.hermes/profiles/qr_frontend/workspace/jt-ai-trading-platform/backend/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# Load DB credentials and optional keys from .env
EnvironmentFile=/home/ubuntu/.hermes/profiles/qr_frontend/workspace/jt-ai-trading-platform/backend/.env

ExecStart=/home/ubuntu/.hermes/profiles/qr_frontend/workspace/jt-ai-trading-platform/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy - always up
Restart=always
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
