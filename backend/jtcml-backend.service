[Unit]
Description=JTCML Trading Platform Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.openclaw/workspace/agents/jtcml_platform/repo/backend
Environment=AZURE_OPENAI_API_KEY=9Hjt8RDYsjBflHI9C0qSJRQYSqfb04qgNyjm6JA42AnnV4BKb7qVJQQJ99BFACqBBLyXJ3w3AAABACOGWJK7
Environment=AZURE_OPENAI_ENDPOINT=https://databricksllmpoc.openai.azure.com/
Environment=AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
Environment=AZURE_OPENAI_API_VERSION=2025-03-01-preview
Environment=SERPER_API_KEY=fbccff7e2b07f4c417387bafadd141b97f1583be
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy - always up
Restart=always
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
