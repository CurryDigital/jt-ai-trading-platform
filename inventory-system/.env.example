# Tang Inventory System - Environment Configuration
# Copy to .env and customize for your environment

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# PORT CONFIGURATION (Isolated from existing services)
# Existing: nginx (80/443), openclaw-gateway (18789/18792)
# ============================================
DB_PORT=5433          # PostgreSQL host port (container: 5432)
API_PORT=3001         # Backend API host port (container: 3000)
FRONTEND_PORT=8081    # Next.js frontend host port (container: 3000)

# ============================================
# DATABASE (PostgreSQL)
# For AWS RDS: set DB_HOST to your RDS endpoint
# ============================================
DB_HOST=db            # Use 'db' for Docker, or RDS endpoint for production
DB_USER=inventory_user
DB_PASSWORD=inventory_secure_password_2024
DB_NAME=inventory_db

# ============================================
# AWS RDS (Production)
# Uncomment and set these for RDS deployment
# ============================================
# DB_HOST=your-rds-instance.region.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=rds_admin
# DB_PASSWORD=your-rds-password
# DB_NAME=inventory_production

# ============================================
# SECURITY
# ============================================
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# ============================================
# BUSINESS LOGIC
# ============================================
LOW_STOCK_THRESHOLD=0.15    # 15% threshold for low stock alerts
FIFO_ENABLED=true           # Enable FIFO valuation

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
