@app.get("/api/market-data")
def get_market_data(tickers: str = "", db: Session = Depends(get_db)):
    """
    Get current market data for multiple tickers.
    Returns: price, change, changePercent for each ticker
    """
    import yfinance as yf
    
    if not tickers:
        return {"success": True, "data": []}
    
    ticker_list = tickers.split(',')
    results = []
    
    for ticker in ticker_list:
        ticker = ticker.strip().upper()
        if not ticker:
            continue
            
        try:
            # Handle special cases
            if ticker == 'BTC':
                ticker = 'BTC-USD'
            elif ticker == 'ETH':
                ticker = 'ETH-USD'
            elif ticker == 'SOL':
                ticker = 'SOL-USD'
            elif ticker == 'GLD':
                ticker = 'GLD'
            elif ticker == 'SLV':
                ticker = 'SLV'
            elif ticker == 'IAU':
                ticker = 'IAU'
            elif ticker == 'SIVR':
                ticker = 'SIVR'
            
            t = yf.Ticker(ticker)
            df = t.history(period="2d")
            
            if df.empty:
                results.append({
                    "ticker": ticker.replace('-USD', '').replace('=F', ''),
                    "price": 0,
                    "change": 0,
                    "changePercent": 0,
                    "error": "No data available"
                })
                continue
            
            price = df['Close'].iloc[-1]
            prev_price = df['Close'].iloc[-2] if len(df) > 1 else price
            change = price - prev_price
            change_percent = (change / prev_price * 100) if prev_price != 0 else 0
            volume = int(df['Volume'].iloc[-1]) if 'Volume' in df.columns else 0
            
            # Handle crypto unit conversion for micro-contracts
            # IBKR crypto positions are in micro units (1/1000 of a coin)
            original_ticker = ticker.replace('-USD', '').replace('=F', '')
            if original_ticker in ['BTC', 'ETH', 'SOL']:
                # Convert to micro-unit price to match entry_price
                price = price / 1000
                prev_price = prev_price / 1000
                change = change / 1000
            
            results.append({
                "ticker": original_ticker,
                "price": round(price, 2),
                "change": round(change, 2),
                "changePercent": round(change_percent, 2),
                "volume": volume,
                "timestamp": df.index[-1].isoformat() if hasattr(df.index[-1], 'isoformat') else str(df.index[-1])
            })
            
        except Exception as e:
            results.append({
                "ticker": ticker.replace('-USD', '').replace('=F', ''),
                "price": 0,
                "change": 0,
                "changePercent": 0,
                "error": str(e)
            })
    
    return {
        "success": True,
        "data": results,
        "count": len(results)
    }


