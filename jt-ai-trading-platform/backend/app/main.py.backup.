        )
        
        comparison[template.id] = {
            "name": template.name,
            "stocks": [{
                "ticker": r.ticker,
                "score": r.strategy_score,
                "win_rate": r.win_rate,
                "sharpe": r.sharpe_ratio,
                "signal": r.signal
            } for r in results]
        }
    
    return {
        "tickers": ticker_list,
        "strategies": comparison
    }


