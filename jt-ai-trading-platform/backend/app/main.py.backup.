        WHERE b.strategy_id = :strategy_id
        AND b.win_rate >= :min_win_rate
        AND b.sharpe_ratio >= :min_sharpe
        {market_filter}
        ORDER BY b.strategy_score DESC
        LIMIT :limit
    """), query_params).fetchall()

