@app.get("/api/paper-strategies/{strategy_id:path}/daily-pnl")
def get_paper_strategy_daily_pnl(strategy_id: str, days: int = 7, db: Session = Depends(get_db)):
    """Get daily P&L breakdown for a paper strategy (last N days)"""
    
    # Calculate date range
    end_date = datetime.datetime.now().date()
    start_date = end_date - datetime.timedelta(days=days)
    
    # Get all positions for this strategy
    positions = db.execute(text("""
        SELECT 
            id,
            ticker,
            realized_pnl,
            unrealized_pnl,
            created_at,
            updated_at,
            trades_count
        FROM gold.paper_strategies
        WHERE strategy_id = :strategy_id
    """), {"strategy_id": strategy_id}).fetchall()
    
    if not positions:
        return {"daily": [], "summary": {"total_realized": 0, "total_unrealized": 0}}
    
    # Generate daily breakdown
    daily_data = []
    current_date = start_date
    
    while current_date <= end_date:
        date_str = current_date.isoformat()
        
        # For each day, calculate the P&L that would have been recorded
        day_realized = 0
        day_unrealized = 0
        
        for pos in positions:
            # Simple allocation: distribute realized/unrealized evenly across days
            # In a real implementation, you'd have actual daily snapshots
            if pos.created_at and pos.created_at.date() <= current_date:
                if pos.trades_count and pos.trades_count > 0:
                    # Position was active on this day
                    days_since_creation = (current_date - pos.created_at.date()).days + 1
                    if days_since_creation > 0:
                        # Distribute realized P&L based on trade count progression
                        day_realized += (pos.realized_pnl or 0) / max(days, 1)
                        day_unrealized += (pos.unrealized_pnl or 0) / max(days, 1)
        
        daily_data.append({
            "date": date_str,
            "realized_pnl": round(day_realized, 2),
            "unrealized_pnl": round(day_unrealized, 2),
            "total_pnl": round(day_realized + day_unrealized, 2)
        })
        
        current_date += datetime.timedelta(days=1)
    
    # Calculate totals
    total_realized = sum(p.realized_pnl or 0 for p in positions)
    total_unrealized = sum(p.unrealized_pnl or 0 for p in positions)
    
    return {
        "daily": daily_data,
        "summary": {
            "total_realized": round(total_realized, 2),
            "total_unrealized": round(total_unrealized, 2),
            "total_pnl": round(total_realized + total_unrealized, 2),
            "position_count": len(positions)
        }
    }


@app.post("/api/strategies/{strategy_id:path}/deactivate")
def deactivate_strategy(strategy_id: str, request: Request, db: Session = Depends(get_db)):
    """
    Deactivate a strategy with two options:
    - action='close': Close all positions and deactivate
    - action='keep': Just deactivate, keep positions open
    """
    try:
        body = request.json()
        action = body.get('action', 'keep')  # 'close' or 'keep'
    except:
        action = 'keep'
    
    # Get all positions for this strategy
    positions = db.execute(text("""
        SELECT id, ticker, invested_capital, status, mode
        FROM gold.paper_strategies
        WHERE strategy_id = :strategy_id
    """), {"strategy_id": strategy_id}).fetchall()
    
    if not positions:
        raise HTTPException(status_code=404, detail=f"No positions found for strategy {strategy_id}")
    
    positions_closed = 0
    
    for pos in positions:
        if action == 'close' and pos.invested_capital > 0:
            # Close the position - mark as closed
            db.execute(text("""
                UPDATE gold.paper_strategies
                SET 
                    status = 'CLOSED',
                    realized_pnl = realized_pnl + unrealized_pnl,
                    unrealized_pnl = 0,
                    invested_capital = 0,
                    available_capital = capital,
                    updated_at = NOW()
                WHERE id = :id
            """), {"id": pos.id})
            positions_closed += 1
            
            # If IBKR order exists, cancel it
            if pos.status == 'ACTIVE' and pos.mode in ['PAPER_TRADING', 'LIVE_TRADING']:
                try:
                    # Cancel any open orders for this position
                    db.execute(text("""
                        UPDATE gold.ib_orders
                        SET status = 'CANCELLED', updated_at = NOW()
                        WHERE paper_strategy_id = :id AND status IN ('PENDING', 'SUBMITTED')
                    """), {"id": pos.id})
                except:
                    pass
        else:
            # Just mark as inactive/paused but keep position
            db.execute(text("""
                UPDATE gold.paper_strategies
                SET 
                    status = 'PAUSED',
                    updated_at = NOW()
                WHERE id = :id
            """), {"id": pos.id})
    
    # Mark strategy as inactive in strategy_definitions
    db.execute(text("""
        UPDATE gold.strategy_definitions
        SET 
            is_active = FALSE,
            updated_at = NOW()
        WHERE strategy_id = :strategy_id
    """), {"strategy_id": strategy_id})
    
    db.commit()
    
    return {
        "success": True,
        "strategy_id": strategy_id,
        "action": action,
        "positions_affected": len(positions),
        "positions_closed": positions_closed if action == 'close' else 0
    }


