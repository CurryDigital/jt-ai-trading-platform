    """
    from fastapi.responses import StreamingResponse
    import csv
    import io

    # Query backtest results
    market_filter = "AND b.market = :market" if market else ""
    query_params = {
        "strategy_id": strategy_id,
        "min_win_rate": min_win_rate / 100,
        "min_sharpe": min_sharpe,
        "limit": 1000
    }
